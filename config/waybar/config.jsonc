{
   "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "tray",
    "battery",
    "pulseaudio",
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "on-scroll-up": "none",
    "on-scroll-down": "none",
    "on-click": "none", // Opcional: también desactiva el clic
    "all-outputs": false,
    "format": "{icon}"
  },
  "network": {
    "format-wifi": "<span color='#83c07c'> 󰤨 </span>{signalStrength}% ",
    "format-ethernet": "<span color='#b8bb26'> </span>Wired ",
    "tooltip-format": "<span color='#fb4934'> 󰅧 </span>{bandwidthUpBytes}  <span color='#b8bb26'> 󰅢 </span>{bandwidthDownBytes}",
    "format-linked": "<span color='#fabd2f'> 󱘖 </span>{ifname} (No IP) ",
    "format-disconnected": "<span color='#fb4934'>  </span>Disconnected ",
    "format-alt": "<span color='#83c07c'> 󰤨 </span>{essid} ",
    "interval": 1
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span color='#b8bb26'> {icon} </span>{capacity}% ",
    "format-charging": " 󱐋{capacity}%",
	  "interval": 1,
    "format-icons": ["󰂎", "󰁼", "󰁿", "󰂁", "󰁹"],
    "tooltip": true
  },
  "pulseaudio": {
    "format": "{icon} {volume}% ",
    "format-muted": "<span color='#fb4934'> 󰖁 </span> 0% ",
    "format-icons": {
      "headphone": "<span color='#d3869b'>  </span>",
      "hands-free": "<span color='#d3869b'>  </span>",
      "headset": "<span color='#d3869b'>  </span>",
      "phone": "<span color='#8ec07c'>  </span>",
      "portable": "<span color='#8ec07c'>  </span>",
      "car": "<span color='#fabd2f'>  </span>",
      "default": [
        "<span color='#928374'>  </span>",
        "<span color='#fabd2f'>  </span>",
        "<span color='#b8bb26'>  </span>"
      ]
    },
    "on-click-right": "pavucontrol -t 3",
    "on-click": "pactl -- set-sink-mute 0 toggle",
  },
  "memory": {
    "format": "<span color='#d3869b'>  </span>{percentage}% ",
    "tooltip-format": "{used:0.1f}G/{total:0.1f}G ",
    "tooltip": true,
  },
  "cpu": {
    "format": "<span color='#fabd2f'>  </span>{usage}% ",
    "tooltip": true
  },
  "clock": {
    "interval": 1,
    "format": "<span color='#d3869b'>  </span>{:%H:%M} ",
    "tooltip": true,
    "tooltip-format": "{:L%Y-%m-%d, %A}"
  },
  "tray": {
    "icon-size": 17,
    "spacing": 6
  }
}

